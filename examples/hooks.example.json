{
  "hue-agent-feedback": {
    "Stop": [
      {
        "type": "command",
        "command": "C:/PATH/TO/HueAgentFeedback/.venv/Scripts/pythonw.exe -m hue_agent_feedback --config C:/PATH/TO/HueAgentFeedback/hue.local.json hook Stop",
        "timeout": 15
      }
    ],
    "PreToolUse": [
      {
        "matcher": "ask_question",
        "hooks": [
          {
            "type": "command",
            "command": "C:/PATH/TO/HueAgentFeedback/.venv/Scripts/pythonw.exe -m hue_agent_feedback --config C:/PATH/TO/HueAgentFeedback/hue.local.json hook PreToolUse",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
